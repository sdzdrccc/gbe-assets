{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbe.dev/schema/kit.json",
  "title": "GBE Kit",
  "description": "套件元数据。★ 面数预算（budgets）与模数（grid）的真源 —— 优先级高于 catalog.config.json 的默认兜底值。CONVENTIONS §3.2 / §3.3 中的表格是本文件的人类可读镜像。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "grid", "budgets"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },

    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "本 kit 启用的 category 子集，取值必须属于 asset.v2 的 category enum。"
    },

    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snap_m", "wall_module_m"],
      "properties": {
        "snap_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "定位网格。一切插槽位置必须为其整数倍（CONVENTIONS §19.2）。"
        },
        "wall_module_m": { "type": "number", "exclusiveMinimum": 0 },
        "story_heights_m": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "pillar_spacing_m": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "ground_tile_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "description": "三角面数预算。真源；catalog.config.json 仅在 kit 缺失时兜底。",
      "properties": {
        "primitive": { "type": "integer", "minimum": 1 },
        "component": { "type": "integer", "minimum": 1 },
        "mass": { "type": "integer", "minimum": 1 },
        "hero": { "type": "integer", "minimum": 1 }
      }
    },

    "materials": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "description": "{ <group>: [<name>...] }，如 { \"roof-tile\": [\"qingwa\", \"liuli-huang\"] }。材质组真源。"
    },

    "axis": {
      "type": "object",
      "additionalProperties": true,
      "description": "冗余声明。值必须等于 CONVENTIONS §1（+Y up / -Z forward），不一致以 §1 为准并报错。"
    },
    "pivot": { "type": "string", "description": "冗余声明，必须为 bottom-center。" },

    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "description": "覆盖度矩阵（派生快照，可重建）：{ \"components/roof\": { \"done\": 5, \"planned\": 5 } }。"
    }
  }
}
